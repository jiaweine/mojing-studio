# Choose the default writing engine. You only need to configure one provider to start.
NOVEL_STUDIO_DEFAULT_PROVIDER=deepseek
NOVEL_STUDIO_DB_PATH=data/novel-studio.db
NOVEL_STUDIO_QUALITY_THRESHOLD=85
NOVEL_STUDIO_MAX_REVISIONS=2
NOVEL_STUDIO_MAX_UPLOAD_MB=32

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-opus-5

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.6-flash

# Optional OpenAI-compatible private gateway.
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=
